{
  "info": {
    "name": "Todo API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      }
    },
    {
      "name": "Create user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ada\",\n  \"email\": \"ada@example.com\"\n}"
        }
      }
    },
    {
      "name": "List users",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      }
    },
    {
      "name": "Create todo (for user 1)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Learn Prisma\",\n  \"userId\": 1\n}"
        }
      }
    },
    {
      "name": "Create todo (no user)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Buy milk\"\n}"
        }
      }
    },
    {
      "name": "List todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        }
      }
    },
    {
      "name": "List todos for user 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/todos?userId=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        }
      }
    },
    {
      "name": "Get todo 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/todos/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "1"
          ]
        }
      }
    },
    {
      "name": "Update todo 1",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/todos/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"completed\": true\n}"
        }
      }
    },
    {
      "name": "User 1 with all todos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/1/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "1",
            "todos"
          ]
        }
      }
    },
    {
      "name": "Delete todo 1",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/todos/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "1"
          ]
        }
      }
    },
    {
      "name": "Invalid: empty title (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/todos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\"\n}"
        }
      }
    },
    {
      "name": "Invalid: unknown todo (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/todos/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "todos",
            "999999"
          ]
        }
      }
    }
  ]
}

