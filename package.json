{
  "name": "todo-api",
  "version": "2.0.0",
  "description": "REST API for a to-do list: Express + Prisma + PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "test": "node --test"
  },
  "keywords": [
    "todo",
    "rest",
    "api",
    "express",
    "prisma",
    "postgresql"
  ],
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  }
}
